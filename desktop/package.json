{
  "name": "financas-pessoais-desktop",
  "productName": "Vorticis Finanças Pessoais",
  "version": "1.0.0",
  "description": "Controle de finanças pessoais",
  "author": "Vorticis Finanças Pessoais",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare-web": "node copy-web.js",
    "start": "node copy-web.js && electron .",
    "dist": "node copy-web.js && electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "br.com.financaspessoais.app",
    "productName": "Vorticis Finanças Pessoais",
    "executableName": "VorticisFinancasPessoais",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "icon.ico",
      "www/**/*"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Vorticis Finanças Pessoais",
      "uninstallDisplayName": "Vorticis Finanças Pessoais",
      "deleteAppDataOnUninstall": false,
      "artifactName": "VorticisFinancasPessoais-Instalador-${version}.${ext}"
    },
    "portable": {
      "artifactName": "VorticisFinancasPessoais-Portatil-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hellisonvidal",
        "repo": "Vorticis-Financas-Pessoais",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  }
}
